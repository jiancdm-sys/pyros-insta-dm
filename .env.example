# Token de longa duração do Instagram (gerado no painel do app Meta)
IG_ACCESS_TOKEN=
# Instagram app secret (valida a assinatura dos webhooks)
IG_APP_SECRET=
# Qualquer texto secreto; o mesmo vai no painel de webhooks da Meta
WEBHOOK_VERIFY_TOKEN=
# Senha para baixar os leads em /api/leads?chave=...
ADMIN_TOKEN=
# Protege o cron de renovação do token (a Vercel envia automaticamente)
CRON_SECRET=
# Criados automaticamente pela integração Upstash na Vercel:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
